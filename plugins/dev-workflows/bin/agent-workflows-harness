#!/bin/sh
# Launch the agent-workflows harness CLI.
#
# The plugin loader puts this directory on PATH, so the harness is reachable as
# a bare command from any working directory. The repo venv is resolved relative
# to this script rather than hardcoded, and `python3 -m` is the fallback for
# installs where no adjacent venv exists.

set -e

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../../.." && pwd)
venv="$root/.venv/bin/agent-workflows-harness"

if [ -x "$venv" ]; then
  exec "$venv" "$@"
fi

exec python3 -m agent_workflows_harness.cli "$@"
